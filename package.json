{
  "name": "light-cart-pos",
  "productName": "Light Cart POS",
  "version": "1.3.0",
  "description": "Windows counter POS for Light Cart merchants",
  "main": "src/main.js",
  "author": "Light Cart",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.electron.light-cart-pos",
    "productName": "Light Cart POS",
    "artifactName": "LightCartPOS-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Light Cart POS",
      "artifactName": "LightCartPOS-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chinarcart",
        "repo": "light-cart-pos"
      }
    ]
  }
}
